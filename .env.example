# Web configuration. Copy to .env; shell/service environment takes precedence.
# Leave BOTH empty until Google OAuth is ready. Never put secrets in VITE_*.
ZM_AI_TOOL_GOOGLE_CLIENT_ID=
ZM_AI_TOOL_GOOGLE_CLIENT_SECRET=

# Optional: local dev/start defaults to http://localhost:5173.
# For production on the server, uncomment:
# ZM_AI_TOOL_WEB_ORIGIN=https://zmaitool.com
# ZM_AI_TOOL_WEB_DATA=/srv/zm-ai-data
# Packages/models are shared across Web accounts, not stored under users/<id>.
# Defaults to the server's existing backend/data; override only to relocate it.
# ZM_AI_TOOL_RESOURCE_DATA=/srv/zm-ai-resources
# Web workers reuse the server's HF_HUB_CACHE / TORCH_HOME for downloaded models.

# Bootstrap the initial owners once; later role changes are stored in SQLite.
ZM_AI_TOOL_OWNER_EMAILS=nguyenmanhict@gmail.com,manhgdev@gmail.com

# APP only: set in the launch environment for local acceptance tests (not VITE_*).
# ZM_AI_TOOL_AUTH_SERVER_URL=http://localhost:18787
