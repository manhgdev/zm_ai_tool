{
  "name": "zm-ai-tool",
  "private": true,
  "version": "8.6.90",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "build": "tsc -b frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "test:frontend": "node --test tests/*.test.mjs",
    "test:i18n": "node --test tests/i18n.catalog.test.mjs",
    "build:app": "node build_app/build.mjs",
    "build:release:macos": "ONEFILE=0 CLEAN=1 npm run build:app && npm run check:build",
    "build:release:windows": "node build_app/build.mjs",
    "build:installer": "node build_app/build_installer.mjs",
    "check:build": "node build_app/check_build.mjs",
    "start": "node scripts/dev.mjs --production",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "clsx": "^2.1.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.12.2",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "archiver": "^7.0.1",
    "tailwindcss": "^4.3.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
